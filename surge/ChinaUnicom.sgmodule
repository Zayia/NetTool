#!name=中国联通组件服务 hotRecommend
#!desc=从联通 App 抓取 ECS 登录凭据，写入 BoxJS，供 Scripting 小组件读取
#!category=组件服务

# 抓取脚本随本模块从 Zayia/NetTool 加载。
[Script]
联通凭据抓取 = type=http-request, pattern=^https:\/\/m\.client\.10010\.com\/navigationService\/naviService\/hotRecommend(?:\?.*)?$, script-path=https://raw.githubusercontent.com/Zayia/NetTool/main/surge/ChinaUnicom.js, requires-body=false, timeout=5

[MITM]
hostname = %APPEND% m.client.10010.com

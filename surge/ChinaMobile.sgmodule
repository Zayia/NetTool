#!name=中国移动组件服务
#!desc=抓取移动登录参数，查询话费与套餐；配合 Zayia BoxJS 和 Scripting 使用。
#!category=组件服务
#!author=ChinaMobileDev, ByteValley, Zayia
#!arguments=CRONEXP:0 9 * * *,TIMEOUT:60,禁用获参重写:'',禁用通知查询:'',禁用PANEL:'',手机号码:'',静默模式:''
#!arguments-desc=手机号和静默模式留空时读取 BoxJS「Zayia 组件服务 → 中国移动」；模块手机号填写后会用于抓取提示、通知、面板和小组件查询。静默模式填 1 关闭抓取及定时通知，填 0 开启。禁用项目填 #。抓取参数变化自动保存，成功通知间隔至少 10 分钟；小组件查询不弹通知。

[Script]
{{{禁用获参重写}}}移动凭据抓取 = type=http-request, pattern=^https:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/[LD]N\/(?:uam(?:onekey|randcode)login|realPersonAuthentication)\/autoLogin(?:\?.*)?$, requires-body=true, max-size=0, timeout=15, script-path=https://raw.githubusercontent.com/Zayia/NetTool/main/Scripts/ChinaMobile.js?v=1.3.1, argument=phonenumber={{{手机号码}}}&silent={{{静默模式}}}
{{{禁用通知查询}}}移动余量通知 = type=cron, cronexp={{{CRONEXP}}}, wake-system=1, timeout={{{TIMEOUT}}}, script-path=https://raw.githubusercontent.com/Zayia/NetTool/main/Scripts/ChinaMobile.js?v=1.3.1, argument=phonenumber={{{手机号码}}}&silent={{{静默模式}}}
{{{禁用PANEL}}}移动余量面板 = type=generic, timeout={{{TIMEOUT}}}, script-path=https://raw.githubusercontent.com/Zayia/NetTool/main/Scripts/ChinaMobile.js?v=1.3.1, argument=icon=arrow.up.arrow.down.circle&icon-color=#5d84f8&phonenumber={{{手机号码}}}&silent={{{静默模式}}}
移动组件查询 = type=http-request, pattern=^https:\/\/api\.example\.com\/zayia\/10086\/query(?:\?.*)?$, requires-body=true, max-size=0, timeout={{{TIMEOUT}}}, script-path=https://raw.githubusercontent.com/Zayia/NetTool/main/Scripts/ChinaMobile.js?v=1.3.1, argument=phonenumber={{{手机号码}}}&silent={{{静默模式}}}

[Panel]
{{{禁用PANEL}}}移动余量 = script-name=移动余量面板, update-interval=21600

[MITM]
hostname = %APPEND% api.example.com, client.app.coc.10086.cn

#!name=中国移动组件服务
#!desc=抓取移动登录参数写入 BoxJS，供 Scripting 直接查询话费和套餐。
#!category=组件服务
#!author=ChinaMobileDev, ByteValley, Zayia

# 手机号和抓取静默模式在 BoxJS「Zayia 组件服务 → 中国移动」中设置。
[Script]
移动凭据抓取 = type=http-request, pattern=^https:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/[LD]N\/(?:uam(?:onekey|randcode)login|realPersonAuthentication)\/autoLogin(?:\?.*)?$, requires-body=true, max-size=0, timeout=15, script-path=https://raw.githubusercontent.com/Zayia/NetTool/main/Scripts/ChinaMobile.js?v=2.0.0

[MITM]
hostname = %APPEND% client.app.coc.10086.cn

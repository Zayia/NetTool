{
  "id": "Zayia.ChinaMobile",
  "name": "Zayia 中国移动",
  "author": "@Zayia / ChinaMobileDev",
  "repo": "https://github.com/Zayia/NetTool",
  "apps": [
    {
      "id": "Zayia.ChinaMobile.Account",
      "name": "中国移动",
      "author": "ChinaMobileDev, Zayia",
      "descs_html": [
        "先填写手机号，再安装 Zayia Surge 模块、启用 MITM 并打开移动 App 捕获登录参数。",
        "变量使用独立的 zayia_china_mobile_ 前缀；添加本订阅不会复制旧版账号，需重新抓取。",
        "无需手动填写 Cookie：查询时自动获取或刷新。请同时保留加密参数、登录地址、加密标识。",
        "相同捕获不重复写入；参数变化自动保存，成功通知最多每 10 分钟一次。静默模式关闭抓取和定时通知，小组件后台查询始终不弹通知。"
      ],
      "keys": [
        "zayia_china_mobile_phonenumber",
        "zayia_china_mobile_params",
        "zayia_china_mobile_url",
        "zayia_china_mobile_x_qen",
        "zayia_china_mobile_cookie",
        "zayia_china_mobile_silent",
        "zayia_china_mobile_bark_key",
        "zayia_china_mobile_capture_notice_at"
      ],
      "settings": [
        {
          "id": "zayia_china_mobile_phonenumber",
          "name": "手机号码",
          "type": "text",
          "val": ""
        },
        {
          "id": "zayia_china_mobile_params",
          "name": "加密登录参数（自动捕获）",
          "type": "textarea",
          "val": ""
        },
        {
          "id": "zayia_china_mobile_url",
          "name": "登录地址（自动捕获）",
          "type": "text",
          "val": ""
        },
        {
          "id": "zayia_china_mobile_x_qen",
          "name": "加密标识（自动捕获）",
          "type": "text",
          "val": ""
        },
        {
          "id": "zayia_china_mobile_cookie",
          "name": "Cookie（自动刷新）",
          "type": "textarea",
          "val": ""
        },
        {
          "id": "zayia_china_mobile_silent",
          "name": "静默模式：关闭抓取和定时通知",
          "type": "boolean",
          "val": false
        },
        {
          "id": "zayia_china_mobile_bark_key",
          "name": "Bark Key（可选）",
          "type": "text",
          "val": ""
        }
      ],
      "scripts": [
        {
          "name": "手动查询移动余量",
          "script": "https://raw.githubusercontent.com/Zayia/NetTool/main/Scripts/ChinaMobile.js?v=1.3.0"
        }
      ]
    }
  ]
}

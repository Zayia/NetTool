#!name=中国联通组件服务
#!desc=获取联通登录凭据，写入独立的 Zayia BoxJS 变量，供 Scripting 小组件读取。
#!author=Zayia
#!tag=组件服务

[Script]
http-request ^https:\/\/m\.client\.10010\.com\/navigationService\/naviService\/hotRecommend(?:\?.*)?$ script-path=https://raw.githubusercontent.com/Zayia/NetTool/main/surge/ChinaUnicom.js?v=1.0.4, requires-body=false, timeout=5, tag=联通凭据抓取

[MITM]
hostname = m.client.10010.com

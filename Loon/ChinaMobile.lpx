#!name=中国移动组件服务
#!desc=抓取移动登录参数并查询话费与套餐，读取「Zayia 组件服务」BoxJS 变量，供 Scripting 小组件使用。
#!author=ChinaMobileDev, ByteValley, Zayia
#!tag=组件服务

# 手机号和静默模式在 BoxJS「Zayia 组件服务 → 中国移动」中设置。
[Script]
http-request ^https:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/[LD]N\/(?:uam(?:onekey|randcode)login|realPersonAuthentication)\/autoLogin(?:\?.*)?$ script-path=https://raw.githubusercontent.com/Zayia/NetTool/main/Scripts/ChinaMobile.js?v=1.3.1, requires-body=true, timeout=15, tag=移动凭据抓取
http-request ^https:\/\/api\.example\.com\/zayia\/10086\/query(?:\?.*)?$ script-path=https://raw.githubusercontent.com/Zayia/NetTool/main/Scripts/ChinaMobile.js?v=1.3.1, requires-body=true, timeout=60, tag=移动组件查询

[MITM]
hostname = client.app.coc.10086.cn, api.example.com
